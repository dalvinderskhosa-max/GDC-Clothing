# ─── Shopify Headless channel ────────────────────────────────────────────────
# This store runs Shopify's **Headless** sales channel, not a custom app.
# Both Storefront tokens come from:
#   Shopify admin → Sales channels → Headless → (your storefront) → Storefront API
#
# There is no Admin API token in this setup, and none is needed: the Headless
# channel issues only `unauthenticated_*` Storefront scopes.

# Permanent .myshopify.com domain of the store.
SHOPIFY_STORE_DOMAIN=gdconline.myshopify.com

# Storefront API version.
SHOPIFY_API_VERSION=2025-07

# "Public access token" — safe in a browser, rate limited per IP.
# Used for all catalogue, collection, page and cart reads.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_access_token

# "Private access token" (shpat_…) — server-side only, higher rate limits.
# Used by /api/subscribe for customerCreate. Never expose this to the client.
# NOTE: historically stored as SHOPIFY_ADMIN_API_TOKEN, which was a misnomer —
# it is a Storefront token, not an Admin one. The old name still works as a
# fallback, but prefer this one.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Canonical site URL, used for metadata, canonical tags and OG. In production
# set this to the deployed URL — not localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
