# --- Shopify Storefront API (safe to be public, but we call it server-side) ---
SHOPIFY_STORE_DOMAIN=7gh6iu-fz.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_token
SHOPIFY_API_VERSION=2025-07

# --- Shopify Admin API (SECRET — server-side only, used for customer capture) ---
# Regenerate this in Shopify: Settings > Apps > Develop apps > [app] > API credentials
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL (used for canonical/OG); set to your Netlify URL in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
